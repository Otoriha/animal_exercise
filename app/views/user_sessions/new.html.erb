<main class="container mx-auto px-4 py-6 max-w-md mt-16 mb-20">
    <div class="bg-white rounded-lg shadow-lg p-8">
        <h1 class="text-center text-gray-700 text-2xl md:text-3xl font-bold mb-6">ログイン</h1>
        
        <%= form_with url: login_path, class: "w-full mx-auto" do |f| %>
            <div class="flex flex-col mb-6">
                <div class="w-full mb-4">
                    <%= f.label :email, "メールアドレス", class: "block text-gray-700 text-sm font-bold mb-2" %>
                    <%= f.email_field :email,
                        class: "shadow appearance-none border rounded w-full py-3 px-4 text-gray-700 leading-tight focus:outline-none focus:shadow-outline focus:border-blue-500",
                        placeholder: "example@email.com" %>
                </div>
                
                <div class="w-full mb-6">
                    <%= f.label :password, "パスワード", class: "block text-gray-700 text-sm font-bold mb-2" %>
                    <%= f.password_field :password,
                        class: "shadow appearance-none border rounded w-full py-3 px-4 text-gray-700 leading-tight focus:outline-none focus:shadow-outline focus:border-blue-500",
                        placeholder: "••••••••" %>
                </div>
                
                <%= f.submit "ログイン", class: "w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-3 px-4 rounded focus:outline-none focus:shadow-outline transition duration-300" %>
            </div>
        <% end %>
        
        <div class="flex flex-col items-center mt-6">
            <div class="mb-4">
                <%= link_to "新規会員登録", new_user_profiles_path, class: "text-blue-500 hover:text-blue-700 font-medium" %>
            </div>
            <div>
                <%= link_to 'パスワードをお忘れの方はコチラ', "#", class: "text-gray-500 hover:text-gray-700 text-sm" %>
            </div>
        </div>
    </div>
</main>